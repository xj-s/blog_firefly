---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const config = announcementConfig;

// 2027 考研初试：2026 年 12 月 19 日（北京时间）。
// 只按“日历天”计算，避免用毫秒差 + Math.ceil 在晚上把天数多算一天。
const examDateLabel = "2026年12月19日";

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<!-- 组件显示现在由sidebarLayoutConfig统一控制，无需检查config.enable -->
<WidgetLayout
  name={config.title || i18n(I18nKey.announcement)}
  id="announcement"
  class={className}
  style={style}
>
  <div>
    <!-- 公告栏内容 - 考研倒计时 -->
    <div class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3">
      <div id="countdown-display" class="text-center">
        <div class="text-2xl font-bold text-[var(--primary)] mb-2">
          <span id="countdown-days">--</span>
          <span class="text-sm font-normal ml-1">天</span>
        </div>
        <div class="text-xs text-neutral-500 dark:text-neutral-400">
          距离2027年考研初试还有
        </div>
        <div class="mt-1 text-[0.62rem] text-neutral-400 dark:text-neutral-500">
          考试日 {examDateLabel} · 北京时间
        </div>
      </div>
    </div>

    <!-- 可选链接和关闭按钮 -->
    <div class="flex items-center justify-between gap-3">
      <div>
        {
          config.link && config.link.enable !== false && (
            <a
              href={config.link.url}
              target={config.link.external ? "_blank" : "_self"}
              rel={config.link.external ? "noopener noreferrer" : undefined}
              class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform"
            >
              {config.link.text}
            </a>
          )
        }
      </div>

      {
        config.closable && (
          <button
            class="btn-regular rounded-lg h-8 w-8 text-sm hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
            onclick="this.closest('widget-layout').style.display='none'"
            aria-label={i18n(I18nKey.announcementClose)}
          >
            <Icon name="fa7-solid:xmark" class="text-sm" />
          </button>
        )
      }
    </div>
  </div>
</WidgetLayout>

<script is:inline>
  (() => {
    const examDate = "2026-12-19";
    const DAY = 86_400_000;
    const daysEl = document.getElementById("countdown-days");
    const labelEl = document.querySelector("#countdown-display .text-xs");

    // 用北京时间取“今天”的日历日期，再按 UTC 零点求差；
    // 这样 23:59 和 00:01 看到的天数只跟日期有关，不会因小时数被 ceil 多算。
    const shanghaiDate = new Intl.DateTimeFormat("en-CA", {
      timeZone: "Asia/Shanghai",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    });

    function dayNumber(dateKey) {
      const [year, month, day] = dateKey.split("-").map(Number);
      return Date.UTC(year, month - 1, day);
    }

    function updateCountdown() {
      if (!daysEl) return;
      const todayKey = shanghaiDate.format(new Date());
      const days = Math.round((dayNumber(examDate) - dayNumber(todayKey)) / DAY);

      if (days < 0) {
        daysEl.textContent = "0";
        if (labelEl) labelEl.textContent = "2027 考研初试已结束";
        return;
      }
      if (days === 0) {
        daysEl.textContent = "0";
        if (labelEl) labelEl.textContent = "今天就是考试日，稳住心态，正常发挥";
        return;
      }

      daysEl.textContent = String(days);
    }

    updateCountdown();
    // 跨过北京时间零点时自动更新；每分钟检查一次即可。
    setInterval(updateCountdown, 60_000);
  })();
</script>
