---
import PoliticsApp from "@components/politics/PoliticsApp.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import "@/styles/politics.css";

const title = "背政治";
const description =
	"27 考研政治背诵工作台：100 个考点拆成 164 张回忆卡，按每日计划遮答案自测、彩色关键词校对、间隔复习。";
---

<MainGridLayout title={title} description={description}>
	<PoliticsApp client:load />
</MainGridLayout>

<script is:inline>
	(() => {
		let observer = null;
		const apply = () => {
			if (!document.querySelector("[data-politics-page]")) return;
			const wallpaper = document.querySelector("#wallpaper-wrapper");
			const grid = document.querySelector("#main-grid");
			const shell = grid?.parentElement?.parentElement;
			if (wallpaper && wallpaper.style.getPropertyValue("display") !== "none") {
				wallpaper.style.setProperty("display", "none", "important");
			}
			if (shell && shell.style.getPropertyValue("top") !== "5.5rem") {
				shell.style.setProperty("top", "5.5rem", "important");
			}
			if (!observer && (wallpaper || shell)) {
				observer = new MutationObserver(apply);
				if (wallpaper) observer.observe(wallpaper, { attributes: true, attributeFilter: ["style"] });
				if (shell) observer.observe(shell, { attributes: true, attributeFilter: ["style"] });
			}
		};
		const toApp = () => {
			const app = document.querySelector("[data-politics-page]");
			if (!app) return;
			if (window.scrollY > 80) return;
			const top = app.getBoundingClientRect().top + window.scrollY - 84;
			window.scrollTo(0, Math.max(0, top));
		};
		apply();
		window.addEventListener("swup:page:view", () => {
			observer?.disconnect();
			observer = null;
			apply();
			window.setTimeout(toApp, 120);
		});
		window.setTimeout(apply, 400);
		window.setTimeout(apply, 1200);
		window.setTimeout(toApp, 350);
		window.setTimeout(toApp, 1300);
	})();
</script>

<style is:global>
	body:has([data-politics-page]) #wallpaper-wrapper {
		display: none !important;
	}
	body:has([data-politics-page]) > div.absolute.w-full.z-30 {
		top: 5.5rem !important;
	}
	#main-grid:has([data-politics-page]) {
		grid-template-columns: minmax(0, 1fr) !important;
		transform: none !important;
	}
	#main-grid:has([data-politics-page]) #category-bar-wrapper {
		display: none !important;
	}
	#main-grid:has([data-politics-page]) #left-sidebar-wrapper,
	#main-grid:has([data-politics-page]) #left-sidebar-dynamic,
	#main-grid:has([data-politics-page]) #right-sidebar-static,
	#main-grid:has([data-politics-page]) #right-sidebar-dynamic,
	#main-grid:has([data-politics-page]) #mobile-bottom-sidebar {
		display: none !important;
	}
	#main-grid:has([data-politics-page]) > div:has(#swup-container) {
		grid-column: 1 / -1 !important;
		overflow: visible !important;
	}
	#main-grid:has([data-politics-page]) > .footer {
		grid-column: 1 / -1 !important;
	}
</style>
