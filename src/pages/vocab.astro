---
import VocabApp from "@components/vocab/VocabApp.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const title = "考研词汇";
const description =
	"考研英语单词查询与记忆：考纲释义、熟词僻义、常见搭配、2010–2026 真题例句，支持生词本与间隔复习。";
---

<MainGridLayout title={title} description={description}>
	<VocabApp client:load />
</MainGridLayout>

<script is:inline>
	// The wallpaper manager writes inline `!important` styles after load, which
	// a stylesheet cannot override. This page is a workspace, so hide the banner
	// and pull the content up to the navbar once the manager has run.
	(() => {
		let observer = null;
		const apply = () => {
			if (!document.querySelector("[data-vocab-page]")) return;
			const wallpaper = document.querySelector("#wallpaper-wrapper");
			const grid = document.querySelector("#main-grid");
			const shell = grid?.parentElement?.parentElement;
			if (wallpaper && wallpaper.style.getPropertyValue("display") !== "none") {
				wallpaper.style.setProperty("display", "none", "important");
			}
			if (shell && shell.style.getPropertyValue("top") !== "5.5rem") {
				shell.style.setProperty("top", "5.5rem", "important");
			}
			if (!observer && (wallpaper || shell)) {
				observer = new MutationObserver(apply);
				if (wallpaper) {
					observer.observe(wallpaper, { attributes: true, attributeFilter: ["style"] });
				}
				if (shell) {
					observer.observe(shell, { attributes: true, attributeFilter: ["style"] });
				}
			}
		};
		const toApp = () => {
			const app = document.querySelector("[data-vocab-page]");
			if (!app) return;
			if (window.scrollY > 80) return;
			const top = app.getBoundingClientRect().top + window.scrollY - 84;
			window.scrollTo(0, Math.max(0, top));
		};
		apply();
		window.addEventListener("swup:page:view", () => {
			observer?.disconnect();
			observer = null;
			apply();
			window.setTimeout(toApp, 120);
		});
		window.setTimeout(apply, 400);
		window.setTimeout(apply, 1200);
		window.setTimeout(toApp, 350);
		window.setTimeout(toApp, 1300);
	})();
</script>

<style is:global>
	/* The vocabulary page is an app-like workspace: hide the blog sidebars and
	   let it use the full content width instead of a narrow centre column. */
	body:has([data-vocab-page]) #wallpaper-wrapper {
		display: none !important;
	}
	body:has([data-vocab-page]) > div.absolute.w-full.z-30 {
		top: 5.5rem !important;
	}
	#main-grid:has([data-vocab-page]) {
		grid-template-columns: minmax(0, 1fr) !important;
		transform: none !important;
	}
	#main-grid:has([data-vocab-page]) #category-bar-wrapper {
		display: none !important;
	}
	#main-grid:has([data-vocab-page]) #left-sidebar-wrapper,
	#main-grid:has([data-vocab-page]) #left-sidebar-dynamic,
	#main-grid:has([data-vocab-page]) #right-sidebar-static,
	#main-grid:has([data-vocab-page]) #right-sidebar-dynamic,
	#main-grid:has([data-vocab-page]) #mobile-bottom-sidebar {
		display: none !important;
	}
	#main-grid:has([data-vocab-page]) > div:has(#swup-container) {
		grid-column: 1 / -1 !important;
		overflow: visible !important;
	}
	#main-grid:has([data-vocab-page]) > .footer {
		grid-column: 1 / -1 !important;
	}
</style>
